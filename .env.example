# OpenAI-compatible LLM settings
LLM_API_KEY=your-api-key
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=https://api.openai.com/v1
LLM_TIMEOUT=60
# Disable this when the configured LLM cannot inspect images.
AMADEUS_LLM_SUPPORTS_IMAGE_INPUT=true
# Optional: extra fields merged into every request body (JSON object)
# Example: LLM_EXTRA_BODY={"chat_template_kwargs": {"enable_thinking": false}}
LLM_EXTRA_BODY=

# Lightweight orchestration max_tokens budget
# Used by the decision layer and short roleplay replies
AMADEUS_LIGHTWEIGHT_MAX_TOKENS=4096

# Single-turn agent tool/skill loop step limit
AMADEUS_AGENT_MAX_STEPS=50

# Image upload budget
# Applies to Web uploads and channel image ingestion.
AMADEUS_IMAGE_MAX_INPUT_BYTES=41943040
AMADEUS_IMAGE_MAX_OUTPUT_BYTES=4194304
AMADEUS_IMAGE_MAX_SIDE=3072
AMADEUS_IMAGE_MAX_PIXELS=24000000

# File upload budget
# Applies to Web uploads and channel file ingestion.
AMADEUS_FILE_MAX_INPUT_BYTES=209715200

# Whether to send a short "I'm checking" acknowledgement before delegating
# to the full background agent
AMADEUS_DELEGATED_ACK_ENABLED=true

# Shell command safety mode
# Available values: danger-full-access, workspace-write, read-only
# This is the startup default. Web Console and chat /runtime commands can
# override it later and persist the override into .echobot/runtime_settings.json.
AMADEUS_SHELL_SAFETY_MODE=danger-full-access

# Runtime logging
REME_LOG_LEVEL=WARNING
AGENTSCOPE_LOG_LEVEL=WARNING

# Web Live2D
AMADEUS_WEB_LIVE2D_MODEL=

# Web TTS
AMADEUS_TTS_PROVIDER=edge
AMADEUS_TTS_KOKORO_AUTO_DOWNLOAD=true
AMADEUS_TTS_KOKORO_MODEL_DIR=
AMADEUS_TTS_KOKORO_PROVIDER=cpu
AMADEUS_TTS_KOKORO_NUM_THREADS=2
AMADEUS_TTS_KOKORO_DEFAULT_VOICE=zf_001
AMADEUS_TTS_KOKORO_DOWNLOAD_TIMEOUT_SECONDS=600
AMADEUS_TTS_KOKORO_URL=
AMADEUS_TTS_KOKORO_LENGTH_SCALE=1.0
AMADEUS_TTS_KOKORO_LANG=

# TTS provider: openai-compatible
# Works with OpenAI-compatible /audio/speech endpoints,
# including OpenAI, vLLM, and local servers that expose the same API.
AMADEUS_TTS_OPENAI_API_KEY=EMPTY
AMADEUS_TTS_OPENAI_MODEL=
AMADEUS_TTS_OPENAI_BASE_URL=https://api.openai.com/v1
AMADEUS_TTS_OPENAI_TIMEOUT=60
AMADEUS_TTS_OPENAI_DEFAULT_VOICE=alloy
AMADEUS_TTS_OPENAI_RESPONSE_FORMAT=wav
# Optional: fallback voices for servers that do not expose GET /v1/audio/voices
AMADEUS_TTS_OPENAI_VOICES=
AMADEUS_TTS_OPENAI_INSTRUCTIONS=
# Optional: extra fields passed through audio.speech.create(..., extra_body=...)
# Example: AMADEUS_TTS_OPENAI_EXTRA_BODY={"language":"English","task_type":"CustomVoice"}
AMADEUS_TTS_OPENAI_EXTRA_BODY=

# Web ASR
AMADEUS_ASR_PROVIDER=sherpa-sense-voice
AMADEUS_ASR_SAMPLE_RATE=16000

# ASR provider: sherpa-sense-voice
AMADEUS_ASR_SHERPA_AUTO_DOWNLOAD=true
AMADEUS_ASR_SHERPA_MODEL_DIR=
AMADEUS_ASR_SHERPA_EXECUTION_PROVIDER=cpu
AMADEUS_ASR_SHERPA_NUM_THREADS=2
AMADEUS_ASR_SHERPA_LANGUAGE=auto
AMADEUS_ASR_SHERPA_USE_ITN=false
AMADEUS_ASR_SHERPA_DOWNLOAD_TIMEOUT_SECONDS=600
AMADEUS_ASR_SHERPA_MODEL_URL=

# ASR provider: openai-transcriptions
# Works with OpenAI-compatible /audio/transcriptions endpoints,
# including OpenAI, vLLM, and local servers that expose the same API.
AMADEUS_ASR_OPENAI_API_KEY=EMPTY
AMADEUS_ASR_OPENAI_MODEL=
AMADEUS_ASR_OPENAI_BASE_URL=https://api.openai.com/v1
AMADEUS_ASR_OPENAI_TIMEOUT=60
AMADEUS_ASR_OPENAI_LANGUAGE=
AMADEUS_ASR_OPENAI_PROMPT=
AMADEUS_ASR_OPENAI_TEMPERATURE=

# Web VAD
# Leave empty or set to none to disable always-listen.
AMADEUS_VAD_PROVIDER=silero

# VAD provider: silero
AMADEUS_VAD_SILERO_AUTO_DOWNLOAD=true
AMADEUS_VAD_SILERO_MODEL_DIR=
AMADEUS_VAD_SILERO_EXECUTION_PROVIDER=cpu
AMADEUS_VAD_SILERO_DOWNLOAD_TIMEOUT_SECONDS=600
AMADEUS_VAD_SILERO_MODEL_URL=
AMADEUS_VAD_SILERO_THRESHOLD=0.5
AMADEUS_VAD_SILERO_MIN_SILENCE_SECONDS=0.4
AMADEUS_VAD_SILERO_MIN_SPEECH_SECONDS=0.2
AMADEUS_VAD_SILERO_MAX_SPEECH_SECONDS=30
AMADEUS_VAD_SILERO_WINDOW_SIZE=512
